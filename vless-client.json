{
  "log": {
    "disabled": false,
    "level": "debug",
    "output": "/etc/sing-box/sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "adguard-dns",
        "type": "tcp",
        "server": "127.0.0.1",
        "server_port": 53
      }
    ],
    "strategy": "ipv4_only",
    "final": "adguard-dns"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "tun0",
      "mtu": 9000,
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true,
      "sniff": true,
      "domain_strategy": "ipv4_only",
      "address": "10.8.0.1/30"
    }
  ],
  "outbounds": [
    {
      "tag": "direct-out",
      "type": "direct"
    },
    {
      "tag": "vless-out",
      "type": "vless",
      "server": "REDACTED",
      "server_port": REDACTED,
      "uuid": "REDACTED",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "REDACTED",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "fragment": true,
        "fragment_fallback_delay": "200ms",
        "record_fragment": false,
        "reality": {
          "enabled": true,
          "public_key": "REDACTED",
          "short_id": "REDACTED"
        }
      },
      "packet_encoding": "xudp"
    },
    {
      "tag": "hysteria2-out",
      "type": "hysteria2",
      "server": "REDACTED",
      "server_port": REDACTED,
      "up_mbps": 80,
      "down_mbps": 80,
      "password": "REDACTED",
      "obfs": {
        "type": "salamander",
        "password": "REDACTED"
      },
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "insecure": false,
        "server_name": "REDACTED"
      }
    },
    {
      "tag": "trojan-out",
      "type": "trojan",
      "server": "REDACTED",
      "server_port": REDACTED,
      "password": "REDACTED",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "REDACTED",
        "alpn": [
          "http/1.1"
        ]
      }
    },
    {
      "tag": "auto-failover",
      "type": "urltest",
      "outbounds": [
        "vless-out",
        "hysteria2-out",
        "trojan-out"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "2m",
      "tolerance": 80,
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geoip-ru-blocked",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/runetfreedom/russia-v2ray-rules-dat/raw/refs/heads/release/sing-box/rule-set-geoip/geoip-ru-blocked.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "geoip-ru-blocked-community",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/runetfreedom/russia-v2ray-rules-dat/raw/refs/heads/release/sing-box/rule-set-geoip/geoip-ru-blocked-community.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-youtube.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "whatsapp",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-whatsapp.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "kinopub",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-kinopub.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "xai",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-xai.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      },
      {
        "tag": "openai",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs",
        "update_interval": "12h",
        "download_detour": "direct-out"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geoip-ru-blocked",
          "geoip-ru-blocked-community",
          "whatsapp",
          "xai",
          "openai"
        ],
        "outbound": "auto-failover"
      },
      {
        "rule_set": [
          "youtube",
          "kinopub"
        ],
        "outbound": "hysteria2-out"
      },
      {
        "domain_suffix": [
          "habr.com",
          "adguard.com",
          "digitalocean.com",
          "intel.com",
          "hashicorp.com",
          "grafana.com",
          "serverfault.com",
          "dnsleaktest.com",
          "autodesk.com",
          "vrdesktop.net"
        ],
        "outbound": "auto-failover"
      },
      {
        "outbound": "direct-out",
        "invert": true
      },
      {
        "ip_is_private": true,
        "outbound": "direct-out"
      }
    ],
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
